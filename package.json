{
  "name": "dsh-robolectric-runner",
  "version": "1.3.1",
  "description": "DeepSeek Harness tool for safe Android local JVM/Robolectric test execution with structured Gradle XML results.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "verify": "node test/verify.mjs",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.0.1-rc.5"
  }
}


